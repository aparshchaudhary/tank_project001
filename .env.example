# ==============================================================================
# TURRET CBPM — Environment Template (.env.example)
# Copy this file to .env and customize values for your deployment
# ==============================================================================

# --- Server & Core Application ---
PROJECT_NAME="TURRET CBPM — Condition-Based Predictive Maintenance & Health Monitoring Platform"
VERSION=1.0.0
PORT=8000
API_V1_STR=/api/v1

# --- Security & JWT Authentication ---
SECRET_KEY=replace_with_your_secure_random_key_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database Storage ---
# SQLite (Default local development):
DATABASE_URL=sqlite:///./turret_cbpm.db
# PostgreSQL / TimescaleDB (Production / Docker):
# DATABASE_URL=postgresql://cbpm_user:cbpm_sec_pass_2026@localhost:5432/cbpm_db

# --- Ingestion & Edge Buffer Resilience ---
OUT_OF_ORDER_TOLERANCE_SECONDS=120.0
DEDUPLICATION_CACHE_SIZE=10000

# --- Baseline & Anomaly Detection Engine ---
DEFAULT_K_SIGMA=3.0
ANOMALY_WARNING_THRESHOLD=0.5
ANOMALY_CRITICAL_THRESHOLD=0.8

# --- Prognostics & Remaining Useful Life (RUL) ---
RUL_MIN_DEGRADATION_SAMPLES=20
RUL_CRITICAL_HEALTH_THRESHOLD=25.0

# --- Frontend Client Configuration (Vite) ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# --- Edge Sensor Telemetry Emitter / Simulator ---
INGESTION_URL=http://localhost:8000/api/v1/ingestion/batch
EMIT_INTERVAL_SECONDS=1.0
SOURCE_ID=TURRET_EDGE_NODE_01
RETRY_DELAY_SECONDS=3.0

# --- ntopng Network Monitoring (Docker Compose) ---
NTOPNG_PORT=3001
REDIS_URL=redis://localhost:6379/0
